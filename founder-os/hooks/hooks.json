{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session-context.py\"",
            "statusMessage": "Loading Founder OS context"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/record-agent.py\"",
            "statusMessage": "Recording Founder OS decision role"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Read|Write|Edit|NotebookEdit|Glob|Grep|apply_patch|Bash|WebFetch|WebSearch|mcp__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/ownership-guard.py\"",
            "statusMessage": "Checking Founder OS boundaries"
          }
        ]
      }
    ]
  }
}
